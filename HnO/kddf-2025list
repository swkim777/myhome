                            <div class="text-sm text-gray-600 space-y-0.5">
                                <p><strong>주관 기관:</strong> ${project.institution}</p>
                                <p><strong>적응증:</strong> ${project.indication || '범용/기타 고형암'}</p>
                                <p><strong>기간:</strong> ${project.period}</p>
                            </div>
                        </div>
                    `;
                });

                html += `
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        // 초기화 함수
        window.onload = function() {
            renderStageDistribution(stats.sortedStages);
            renderAreaDistribution(stats.sortedAreas);
            renderProjectList(projectData);
        };
    </script>
</body>
</html>
