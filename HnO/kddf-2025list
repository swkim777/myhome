        // 개발 단계 매핑 및 색상 정의
        const STAGE_MAP = {
            '기초연구': { label: '기초 (Hit-to-Lead)', color: 'bg-indigo-500', order: 10 },
            '유효물질': { label: '유효물질 (Hit-to-Lead)', color: 'bg-indigo-500', order: 10 },
            '선도물질': { label: '선도물질 (Lead)', color: 'bg-blue-500', order: 20 },
            '후보물질': { label: '후보물질 (Candidate)', color: 'bg-green-500', order: 30 },
            '비임상': { label: '비임상 (Preclinical)', color: 'bg-teal-500', order: 40 },
            '임상 1상': { label: '임상 1상 (Clinical I)', color: 'bg-amber-500', order: 50 },
            '임상 2상': { label: '임상 2상 (Clinical II)', color: 'bg-red-500', order: 60 },
            '임상 3상': { label: '임상 3상 (Clinical III)', color: 'bg-red-700', order: 70 },
            '연구개발 중': { label: '플랫폼/기타', color: 'bg-gray-400', order: 80 }
