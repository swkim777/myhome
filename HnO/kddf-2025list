            "심혈관 (심혈관/대사성 질환 분야)": "border-amber-500",
            "호흡기 (호흡기 질환 분야)": "border-teal-500",
            "소화기 (소화기 질환 분야)": "border-purple-500",
            "혈액질환 (혈액 암/질환 분야)": "border-pink-500",
            "기타 (희귀질환 및 기타 분야)": "border-gray-500",
        };
        
        // 데이터 집계 및 계산
        function calculateStats() {
            const stageCounts = {};
            const areaCounts = {};

            Object.entries(projectData).forEach(([area, projects]) => {
                const cleanArea = area.split('(')[0].trim();
                areaCounts[area] = (areaCounts[area] || 0) + projects.length;

                projects.forEach(project => {
                    // 유효물질 탐색 (기초연구) -> 유효물질, 유효물질/선도물질 발굴 -> 선도물질 등으로 통일
                    let stageKey = project.stage.split('(')[0].trim().replace('발굴 및 선도물질 확보', '선도물질');

                    // 복합 단계 처리 (유효물질 및 선도물질) -> 더 상위 단계로 분류 (선도물질)
                    if (stageKey.includes('및')) {
                        if (stageKey.includes('선도물질')) {
                            stageKey = '선도물질';
                        } else if (stageKey.includes('유효물질')) {
                            stageKey = '유효물질';
                        }
                    }
                    
                    // 상세 단계 매핑
                    let finalStage;
                    if (stageKey.includes('유효물질')) finalStage = '유효물질';
                    else if (stageKey.includes('선도물질')) finalStage = '선도물질';
                    else if (stageKey.includes('후보물질')) finalStage = '후보물질';
                    else if (stageKey.includes('비임상')) finalStage = '비임상';
                    else if (stageKey.includes('임상 1상')) finalStage = '임상 1상';
                    else if (stageKey.includes('임상 2상')) finalStage = '임상 2상';
                    else if (stageKey.includes('연구개발')) finalStage = '연구개발 중';
                    else finalStage = '기타';

                    stageCounts[finalStage] = (stageCounts[finalStage] || 0) + 1;
                });
            });

            // 데이터 정렬
            const sortedStages = Object.entries(stageCounts)
                .map(([stage, count]) => {
                    const mapped = STAGE_MAP[stage] || { label: stage, color: 'bg-gray-400', order: 99 };
                    return { stage: mapped.label, count, color: mapped.color, order: mapped.order };
                })
                .sort((a, b) => a.order - b.order);

            const totalCount = sortedStages.reduce((sum, item) => sum + item.count, 0);

            // 상위 4개 분야 추출
            const sortedAreas = Object.entries(areaCounts)
                .sort(([, countA], [, countB]) => countB - countA);
            
            return { sortedStages, sortedAreas, totalCount };
        }

        const stats = calculateStats();
        const TOTAL_PROJECTS_COUNT = 128; // 원본 데이터에서 언급된 총 개수

        // --------------------------------------------------------------------------
        // 1. 개발 단계별 분포 (Progress Bar Chart) 렌더링
        // --------------------------------------------------------------------------
        function renderStageDistribution(data) {
            const container = document.getElementById('stage-distribution');
            let html = `
                <div class="space-y-4">
                    <p class="text-sm text-gray-500 font-medium">※ 목록에 상세 기재된 ${stats.totalCount}개 과제 기준</p>
            `;

            data.forEach(item => {
                const percentage = ((item.count / stats.totalCount) * 100).toFixed(1);
                html += `
                    <div class="flex flex-col">
                        <div class="flex justify-between text-sm font-medium mb-1">
                            <span class="text-gray-700">${item.stage}</span>
                            <span class="text-gray-900">${item.count}개 (${percentage}%)</span>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-fill ${item.color}" style="width: ${percentage}%;"></div>
                        </div>
                    </div>
                `;
            });

            // 임상 단계 합산 (Clinical Stage Sum)
            const clinicalStages = ['임상 1상 (Clinical I)', '임상 2상 (Clinical II)', '임상 3상 (Clinical III)'];
            const clinicalCount = data
                .filter(item => clinicalStages.includes(item.stage))
                .reduce((sum, item) => sum + item.count, 0);
            
            const clinicalPercentage = ((clinicalCount / stats.totalCount) * 100).toFixed(1);

            html += `
                <div class="mt-6 p-3 bg-red-100 border border-red-300 rounded-lg">
                    <p class="text-lg font-bold text-red-700">총 임상 단계 과제:</p>
                    <p class="text-2xl font-extrabold text-red-900">${clinicalCount}개 (${clinicalPercentage}%)</p>
                </div>
            `;
            
            html += `</div>`;
            container.innerHTML = html;
        }


        // --------------------------------------------------------------------------
        // 2. 질환 분야별 비중 (Doughnut/Pie-like Chart - Simplified HTML) 렌더링
