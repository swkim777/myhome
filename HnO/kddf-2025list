                            <span class="ml-auto text-lg font-semibold text-gray-500">(${totalCount}개 과제)</span>
                        </h3>
                        <div class="space-y-4">
                `;

                projects.forEach(project => {
                    // 단계에 맞는 색상 찾기 (STAGE_MAP의 value)
                    const stageKey = Object.keys(STAGE_MAP).find(key => project.stage.includes(key) || key.includes(project.stage)) || '기타';
                    const stageStyle = STAGE_MAP[stageKey] || { label: project.stage, color: 'bg-gray-400' };

                    html += `
                        <div class="project-card p-4 rounded-lg bg-gray-50 border-l-4 ${areaColor}">
                            <div class="flex justify-between items-start mb-1">
                                <h4 class="text-base font-bold text-gray-800">${project.name}</h4>
